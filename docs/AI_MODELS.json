{
  "version": "0.1.0",
  "language_lock": {
    "response": "ko",
    "reasoning": "ko",
    "enforced": true
  },
  "doc_first": {
    "enabled": true,
    "required_files": [
      "docs/plans/PLAN_v0.1.0_common.md",
      "docs/TODO.md",
      "docs/PRD.md",
      "docs/DESIGN.md"
    ],
    "session_auto_save_minutes": 15
  },
  "default_chain": ["openrouter/free", "gemini-1.5-flash", "openrouter/paid-fallback"],
  "models": {
    "chat": { "model": "gemini-2.0-flash", "temperature": 0.2, "max_tokens": 4096, "prompt_version": "chat_v0.1", "vision_support": false },
    "code": { "model": "gemini-2.0-flash", "temperature": 0.1, "max_tokens": 8192, "prompt_version": "code_v0.1", "vision_support": false },
    "seo": { "model": "gemini-2.0-flash", "temperature": 0.3, "max_tokens": 2048, "prompt_version": "seo_v0.1", "vision_support": false }
  },
  "platforms": {
    "web": { "model": "code", "perf_budget": { "lcp_ms": 2500, "memory_mb": 150 } },
    "macos": { "model": "code", "perf_budget": { "cold_start_ms": 1500, "memory_mb": 300, "fps": 60 } }
  },
  "cache_policy": {
    "enabled": true,
    "ttl_days": 7,
    "max_entries_macos": 500,
    "max_entries_server": 10000,
    "hit_rate_target": 0.7,
    "storage": "SQLite (macos) + server cache"
  },
  "cost_guard": { "max_cost_per_task_usd": 1.0, "alert_at_usd": 0.5, "include_saved": true },
  "e2e": { "playwright_project": "web", "k6_threshold_p95_ms": 300 }
}